{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vitest/globals", "jsdom", "node"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "files": [
    "src/test-setup.ts",
    "src/vitest.d.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
