    <wsdl:operation name="Z_MMRFC_OC_PARA_SOLP">
      <wsdl:input xmlns:rfc="urn:sap-com:document:sap:rfc:functions" message="rfc:Z_MMRFC_OC_PARA_SOLP.Input" />
      <wsdl:output xmlns:rfc="urn:sap-com:document:sap:rfc:functions" message="rfc:Z_MMRFC_OC_PARA_SOLP.Output" />
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding xmlns:rfc="urn:sap-com:document:sap:rfc:functions" name="Z_MMRFC_OC_PARA_SOLP.PortTypeBinding" type="rfc:Z_MMRFC_OC_PARA_SOLP.PortType">
    <binding transport="http://schemas.xmlsoap.org/soap/http" xmlns="http://schemas.xmlsoap.org/wsdl/soap/" />
