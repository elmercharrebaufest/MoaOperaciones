              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="12" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="PERSON_EXT">
            <xsd:annotation>
              <xsd:documentation>Person Responsible (Externally)</xsd:documentation>
            </xsd:annotation>
