              <xsd:documentation>External Entry Sheet Number (Dependencies: See Long Text)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="35" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="BAPIESLLC">
        <xsd:annotation>
          <xsd:documentation>Communication Structure: Create Service Line</xsd:documentation>
        </xsd:annotation>
