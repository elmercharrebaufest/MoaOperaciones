            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="1" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="PERS_NO">
            <xsd:annotation>
              <xsd:documentation>Personnel Number</xsd:documentation>
