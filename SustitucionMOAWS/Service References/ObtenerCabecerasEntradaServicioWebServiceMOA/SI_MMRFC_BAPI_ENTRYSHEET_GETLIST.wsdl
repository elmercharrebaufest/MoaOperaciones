          <xsd:element minOccurs="0" name="PERSON_INT">
            <xsd:annotation>
              <xsd:documentation>Person Responsible (Internally)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="12" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="PERSON_EXT">
